<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.cuioss</groupId>
        <artifactId>cui-parent-pom</artifactId>
        <version>1.7-SNAPSHOT</version>
    </parent>

    <artifactId>cui-java-bom</artifactId>
    <packaging>pom</packaging>
    <name>cui java dependency management</name>
    <description>Provides a number of standard-java dependency-declarations that
        can be consumed directly
    </description>

    <modules>
        <module>cui-java-parent</module>
    </modules>

    <properties>
        <version.cui.core.ui.model>2.4.0</version.cui.core.ui.model>
        <version.cui.java.tools>2.7.0</version.cui.java.tools>
        <version.cui.http>3.0</version.cui.http>
        <!-- Test -->
        <!-- The version needs to be aligned with the one defined within the quarkus boms.
        Otherwise, it's getting messy-->
        <version.junit.jupiter>6.1.3</version.junit.jupiter>
        <version.hamcrest>3.0</version.hamcrest>
        <version.cui.test.juli.logger>2.1.4</version.cui.test.juli.logger>
        <version.cui.test.generator>3.0.2</version.cui.test.generator>
        <version.cui.test.value.objects>2.1.3</version.cui.test.value.objects>
        <version.cui.test.mockwebserver>1.6</version.cui.test.mockwebserver>

        <version.easymock>5.7.0</version.easymock>
        <version.jdom2>2.0.6.1</version.jdom2>
        <version.awaitility>4.3.0</version.awaitility>
        <version.jspecify>1.0.1</version.jspecify>
        <version.archunit>1.5.0</version.archunit>
        <version.jmh>1.37</version.jmh>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Standard Third Parties -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${version.lombok}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>org.jspecify</groupId>
                <artifactId>jspecify</artifactId>
                <version>${version.jspecify}</version>
                <scope>compile</scope>
            </dependency>
            <!-- https://mvnrepository.com/artifact/org.jdom/jdom2 -->
            <dependency>
                <groupId>org.jdom</groupId>
                <artifactId>jdom2</artifactId>
                <version>${version.jdom2}</version>
                <scope>compile</scope>
            </dependency>

            <!-- CUI-standard Tools -->
            <dependency>
                <groupId>de.cuioss</groupId>
                <artifactId>cui-java-tools</artifactId>
                <version>${version.cui.java.tools}</version>
                <scope>compile</scope>
            </dependency>
            <dependency>
                <groupId>de.cuioss</groupId>
                <artifactId>cui-http</artifactId>
                <version>${version.cui.http}</version>
            </dependency>
            <!-- The curated http.security attack databases, shipped as a classifier variant of
                 the same artifact. Managed here so it cannot drift from the main one: a classifier
                 is a distinct managed key, and leaving it out meant every consumer had to pin it
                 by hand off ${version.cui.http}. That works only for consumers that INHERIT this
                 BOM - one that imports it gets dependencyManagement but no properties, and so had
                 no way to express "same version as cui-http" at all. -->
            <dependency>
                <groupId>de.cuioss</groupId>
                <artifactId>cui-http</artifactId>
                <version>${version.cui.http}</version>
                <classifier>generators</classifier>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>de.cuioss</groupId>
                <artifactId>cui-core-ui-model</artifactId>
                <version>${version.cui.core.ui.model}</version>
                <scope>compile</scope>
            </dependency>
            <!-- Testing -->
            <!-- CUI-Testing -->
            <dependency>
                <groupId>de.cuioss.test</groupId>
                <artifactId>cui-test-juli-logger</artifactId>
                <version>${version.cui.test.juli.logger}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>de.cuioss.test</groupId>
                <artifactId>cui-test-value-objects</artifactId>
                <version>${version.cui.test.value.objects}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>de.cuioss.test</groupId>
                <artifactId>cui-test-generator</artifactId>
                <version>${version.cui.test.generator}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>de.cuioss.test</groupId>
                <artifactId>cui-test-mockwebserver-junit5</artifactId>
                <version>${version.cui.test.mockwebserver}</version>
                <scope>test</scope>
            </dependency>
            <!-- Junit 5 cui-jsf-test-basic-->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${version.junit.jupiter}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-api</artifactId>
                <version>${version.junit.jupiter}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-engine</artifactId>
                <version>${version.junit.jupiter}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-params</artifactId>
                <version>${version.junit.jupiter}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-migrationsupport</artifactId>
                <version>${version.junit.jupiter}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.vintage</groupId>
                <artifactId>junit-vintage-engine</artifactId>
                <version>${version.junit.jupiter}</version>
                <scope>test</scope>
            </dependency>
            <!-- JUnit Platform travels with Jupiter: since JUnit 6 the two share one version
                 number, so pinning them apart is how a Jupiter 6.x consumer ends up dragging in a
                 stale Platform transitively. Consumers used to re-declare this block themselves;
                 it belongs with the rest of the org.junit.* coordinates this BOM already owns.
                 Deliberately no <scope>: these are aligned transitively, and managing a scope here
                 would re-scope them wherever they arrive that way. -->
            <dependency>
                <groupId>org.junit.platform</groupId>
                <artifactId>junit-platform-launcher</artifactId>
                <version>${version.junit.jupiter}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.platform</groupId>
                <artifactId>junit-platform-engine</artifactId>
                <version>${version.junit.jupiter}</version>
            </dependency>
            <!-- The single Hamcrest artifact. This replaced hamcrest-core and hamcrest-library,
                 which upstream deprecated - their POMs read "deprecated, please use hamcrest
                 instead" - and which now ship as empty shims depending only on this one.
                 Managing those two instead of this one meant this BOM pinned the two coordinates
                 nothing declares, while leaving the coordinate every consumer uses unmanaged. -->
            <dependency>
                <groupId>org.hamcrest</groupId>
                <artifactId>hamcrest</artifactId>
                <version>${version.hamcrest}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.easymock</groupId>
                <artifactId>easymock</artifactId>
                <version>${version.easymock}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.awaitility</groupId>
                <artifactId>awaitility</artifactId>
                <version>${version.awaitility}</version>
                <scope>test</scope>
            </dependency>
            <!-- Architecture tests. Both artifacts are managed: archunit is the plain API,
                 archunit-junit5 the JUnit 5 integration, and repos here use one or the other. -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit</artifactId>
                <version>${version.archunit}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${version.archunit}</version>
                <scope>test</scope>
            </dependency>
            <!-- JMH. jmh-core and the annotation processor must move together, so both are
                 managed here rather than paired by hand in each benchmark module.

                 Deliberately no <scope>. A benchmark harness keeps its sources in
                 src/main/java and declares jmh-core at compile scope; managing a test scope
                 here silently rewrote that to test, because dependencyManagement supplies
                 every field the declaration omits - not only the version. Verified against
                 cui-http-benchmarking, where the scope did flip. -->
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-core</artifactId>
                <version>${version.jmh}</version>
            </dependency>
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-generator-annprocess</artifactId>
                <version>${version.jmh}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
